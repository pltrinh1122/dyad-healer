{
  "permissions": {
    "allow": [
      "Bash(bin/git.sh:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/bin/standup.sh --hook" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/bin/standdown.sh --log" }
        ]
      }
    ]
  }
}
